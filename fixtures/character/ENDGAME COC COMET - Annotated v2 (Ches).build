 "inventory_slots": [
  {
   "additional_text": "Pyrophyte Staff\n1. 88% increased Spell Damage\n2. 49% increased Cast Speed\n3. 89% increased Critical Hit Chance for Spells\n4. Gain 60% of Damage as Extra Fire Damage\n5. Gain 54% of Damage as Extra Cold Damage\n\n<gold>{STAFF = biggest damage slot.\nPrefixes: gain dmg as extra > incr. spell dmg > incr. COLD dmg (not lightning!)\nSuffixes: +levels all spell skills > cast speed > crit chance\nSpirit: amanamu prefix craft (35-50). Trade tip: sort by SUM, set max buyout.}",
   "inventory_id": "Weapon1",
   "level_interval": [
    16,
    100
   ],
   "slot_x": 0,
   "slot_y": 0
  },
  {
   "additional_text": "Ancestral Tiara\n1. +41 to maximum Life\n2. +40% to Cold Resistance\n3. +20% to Lightning Resistance\n4. +70 to maximum Energy Shield\n5. 38% increased Energy Shield\n6. 20% increased Energy Shield Recharge Rate\n\n<gold>{Spirit corruption 20-30 if you are short.} <grey>{ES, res, Int.}",
   "inventory_id": "Helm1",
   "level_interval": [
    80,
    100
   ],
   "slot_x": 0,
